{
  "$schema": "https://webreel.dev/schema/v1.json",
  "baseUrl": "http://localhost:8000",
  "outDir": "videos/",
  "viewport": { "width": 1920, "height": 1080 },
  "defaultDelay": 600,
  "videos": {
    "hast-demo": {
      "url": "/login",
      "waitFor": "#email",
      "steps": [
        { "action": "pause", "ms": 800 },
        { "action": "click", "selector": "#email" },
        { "action": "type", "text": "prof@test.edu", "charDelay": 30 },
        { "action": "click", "selector": "#password" },
        { "action": "type", "text": "TestPassword123!", "charDelay": 20, "delay": 500 },
        { "action": "click", "selector": "button[type='submit']" },
        { "action": "pause", "ms": 8000 },

        { "action": "scroll", "y": 400 },
        { "action": "pause", "ms": 1200 },
        { "action": "scroll", "y": 400 },
        { "action": "pause", "ms": 1200 },
        { "action": "scroll", "y": 500, "delay": 800 },
        { "action": "pause", "ms": 1500 },
        { "action": "scroll", "y": 500, "delay": 800 },
        { "action": "pause", "ms": 2000 },
        { "action": "scroll", "y": 500, "delay": 800 },
        { "action": "pause", "ms": 2000 },

        { "action": "click", "text": "Settings" },
        { "action": "pause", "ms": 1500 },
        { "action": "scroll", "y": 300 },
        { "action": "pause", "ms": 1200 },
        { "action": "scroll", "y": 400 },
        { "action": "pause", "ms": 1500 },

        { "action": "click", "text": "Dashboard" },
        { "action": "pause", "ms": 2000 },
        { "action": "click", "text": "Upload Submission" },
        { "action": "pause", "ms": 800 },
        { "action": "click", "text": "Math" },
        { "action": "pause", "ms": 1200 },
        { "action": "scroll", "y": 200 },
        { "action": "pause", "ms": 800 },
        { "action": "scroll", "y": -200 },
        { "action": "click", "text": "Submit", "delay": 3000 },
        { "action": "click", "text": "Algebra II", "delay": 2000 },
        { "action": "pause", "ms": 3000 },

        { "action": "click", "text": "Dashboard" },
        { "action": "pause", "ms": 2000 },
        { "action": "click", "text": "Upload Submission" },
        { "action": "pause", "ms": 800 },
        { "action": "click", "text": "Mec. Fluidos" },
        { "action": "pause", "ms": 1500 },
        { "action": "click", "text": "Submit", "delay": 3000 },
        { "action": "click", "text": "Mecánica de los Fluidos", "delay": 2000 },
        { "action": "pause", "ms": 3000 }
      ]
    }
  }
}
