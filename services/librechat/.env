# LibreChat Configuration
HOST=0.0.0.0
PORT=3080

# Disable default OpenAI endpoint (we only use custom Hermes endpoint)
ENDPOINTS=custom

# Allow registration for demo purposes
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# Session expiry (ms)
SESSION_EXPIRY=604800000
REFRESH_TOKEN_EXPIRY=2419200000
