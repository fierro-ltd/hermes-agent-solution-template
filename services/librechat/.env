# LibreChat Configuration
HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat

# Disable default OpenAI endpoint (we only use custom Hermes endpoint)
OPENAI_API_KEY=unused

# Allow registration for demo purposes
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# Session secret
SESSION_EXPIRY=1000 * 60 * 60 * 24 * 7
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24 * 7) * 4

# Hermes API key (passed from parent .env)
HERMES_API_KEY=${HERMES_API_KEY:-edu-platform-test-key-2026}
