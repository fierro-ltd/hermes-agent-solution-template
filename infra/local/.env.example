# Hermes Agent Configuration
# OpenCode Go API key — used by Hermes for text models (GLM-5)
# Get your key at: https://opencode.ai/auth
OPENCODE_GO_API_KEY=your-opencode-go-api-key

# Hermes API Server auth — pick any secret string you want.
# This is a self-assigned password that protects the Hermes /v1/chat/completions endpoint.
# The API and worker containers use this same value to authenticate when calling Hermes.
HERMES_API_KEY=pick-any-secret-string-here

# better-auth Configuration
# Random secret string used for signing sessions (required in production)
AUTH_SECRET=change-me-to-a-random-secret-string
# Auth service URL (defaults to http://auth:3100 inside Docker; no need to change for local dev)
# AUTH_SERVICE_URL=http://auth:3100

# OAuth Providers (optional — leave empty to disable)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Mission Control — agent observability dashboard
# MC_AUTH_USER=admin
# MC_AUTH_PASS=pick-a-password
# MC_API_KEY=pick-any-secret-for-agent-reporting

# Database (override only if not using default Docker Compose values)
# DATABASE_URL=postgresql://app_user:app_password@postgres:5432/app_db

# Temporal (override only if not using default Docker Compose values)
# TEMPORAL_ADDRESS=temporal:7233

# Auth bypass -- set to "true" to disable auth even when AUTH_SECRET is set.
# Useful for debugging deployed environments. Never enable in real production.
# AUTH_BYPASS=false

# Temporal UI port -- the frontend builds the full URL from the browser origin.
# Local dev: 8233 (direct). Production: 9233 (Caddy HTTPS proxy).
# TEMPORAL_UI_PORT=8233

# Grading workflow
TASK_QUEUE=grading
GRADING_TIMEOUT_DAYS=7
