# Hermes Agent Configuration
# The model provider Hermes uses for LLM inference (anthropic, openrouter, opencode-go, etc.)
HERMES_MODEL_PROVIDER=openrouter
# Your LLM provider API key (e.g. OpenRouter, Anthropic, OpenCode Go)
LLM_API_KEY=your-llm-provider-api-key

# Hermes API Server auth — pick any secret string you want.
# This is a self-assigned password that protects the Hermes /v1/chat/completions endpoint.
# The API and worker containers use this same value to authenticate when calling Hermes.
HERMES_API_KEY=pick-any-secret-string-here

# better-auth Configuration
# Random secret string used for signing sessions (required in production)
AUTH_SECRET=change-me-to-a-random-secret-string
# URL of the better-auth service (frontend uses this for login/signup)
VITE_AUTH_URL=http://localhost:3100

# OAuth Providers (optional — leave empty to disable)
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Database (override only if not using default Docker Compose values)
# DATABASE_URL=postgresql://app_user:app_password@postgres:5432/app_db

# Temporal (override only if not using default Docker Compose values)
# TEMPORAL_ADDRESS=temporal:7233

# Grading workflow
TASK_QUEUE=grading
GRADING_TIMEOUT_DAYS=7
